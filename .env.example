# App
VITE_DM_CLIENT=mock

# GCP / Vertex
GCP_PROJECT=your-project-id
VERTEX_REGION=us-central1
ASSETS_BUCKET=your-assets-bucket

# Gemini models (Vertex AI)
# NOTE: gemini-3.1-pro-preview serves ONLY on the GLOBAL endpoint — use
# location="global" for the Pro model. Regional services (Flash, embeddings,
# Firestore, Storage) use VERTEX_REGION above.
GEMINI_PRO_MODEL=gemini-3.1-pro-preview
GEMINI_FLASH_MODEL=gemini-3-flash
EMBEDDING_MODEL=

# MCP servers (local dev) — port set by the slice
DICE_MCP_URL=http://localhost:8080/mcp